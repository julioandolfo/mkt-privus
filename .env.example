APP_NAME="MKT Privus"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_PORT=80

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ===== DATABASE =====
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=mkt_privus
DB_USERNAME=mkt_privus
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

# ===== SESSION =====
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ===== BROADCAST / FILESYSTEM / QUEUE / CACHE =====
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
CACHE_STORE=redis
# retry_after deve ser MAIOR que o timeout do PublishPostJob (280s) e que o
# --timeout do worker, senão jobs de vídeo são reprocessados (post duplicado).
DB_QUEUE_RETRY_AFTER=320
REDIS_QUEUE_RETRY_AFTER=320

# ===== REDIS =====
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ===== MAIL =====
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@mktprivus.com"
MAIL_FROM_NAME="${APP_NAME}"

# ===== MINIO (S3-COMPATIBLE STORAGE) =====
AWS_ACCESS_KEY_ID=mktprivus
AWS_SECRET_ACCESS_KEY=mktprivussecret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=mkt-privus
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ===== MEILISEARCH =====
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=mktprivusMeiliKey2026
MEILISEARCH_PORT=7700

# ===== REVERB (WEBSOCKET) =====
REVERB_APP_ID=mkt-privus
REVERB_APP_KEY=mkt-privus-key
REVERB_APP_SECRET=mkt-privus-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ===== AI PROVIDERS =====
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ===== SOCIAL MEDIA APIs =====
# Meta (Facebook + Instagram) — integração direta
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=

# YouTube / Google — integração direta
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ANALYTICS_PROPERTY_ID=

# Postiz — gateway para LinkedIn, LinkedIn Page, TikTok, Google My Business
# Obtenha a API key em: Postiz > Settings > Developers > Public API
# Pode ser configurado diretamente pelo admin em Settings > OAuth no painel.
POSTIZ_API_URL=https://api.postiz.com/public/v1
POSTIZ_API_KEY=
POSTIZ_WEBHOOK_SECRET=

# ===== ANALYTICS =====
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=

# ===== WORDPRESS =====
# Configurado por marca na interface

VITE_APP_NAME="${APP_NAME}"

# ===== BILLING / SAAS (Mercado Pago) =====
# Habilita assinaturas e limites de plano. Com false, o sistema se comporta
# como instalação single-tenant (sem cobrança e sem limites).
BILLING_ENABLED=false
BILLING_TRIAL_DAYS=14
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# Secret de assinatura dos webhooks (painel Mercado Pago > Suas integrações > Webhooks)
MERCADOPAGO_WEBHOOK_SECRET=

# Token compartilhado para validar webhooks do SendPulse.
# Configure a URL do webhook como: https://seu-dominio/webhook/sendpulse?token=<valor>
SENDPULSE_WEBHOOK_TOKEN=

# E-mail do administrador para alertas operacionais (jobs falhados na fila)
ADMIN_ALERT_EMAIL=

# Bootstrap do super admin no primeiro deploy (admin:create --ensure roda no
# entrypoint). Só é usado se nenhum administrador existir ainda; depois disso
# toda a gestão é pela UI (Contas Admin). Remova após o primeiro deploy.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=
